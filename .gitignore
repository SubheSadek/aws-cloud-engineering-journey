*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Terraform plans
*.tfplan
tfplan

# ==========================================
# SSH Keys and Certificates
# ==========================================
id_rsa
id_ed25519
*.key
*.crt

